-- =============================================
-- DROPWAY - โค้ดฐานข้อมูลเรียบง่าย (เก็บ houses ถาวร + today/pending ชั่วคราว + start_positions สำหรับจุดเริ่มต้นนำทาง)
-- =============================================
-- เปิด UUID
-- =============================================
-- DROPWAY - โค้ดฐานข้อมูล (เพิ่ม note แล้ว)
-- =============================================
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. houses (คลังบ้านถาวร) ← เพิ่ม note
DROP TABLE IF EXISTS public.houses CASCADE;
CREATE TABLE public.houses (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  full_name TEXT NOT NULL,
  phone TEXT NOT NULL,
  address TEXT NOT NULL,
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  note TEXT,                                    -- เพิ่ม note
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
ALTER TABLE public.houses DISABLE ROW LEVEL SECURITY;

-- 3. today_houses (งานวันนี้) ← เพิ่ม note
DROP TABLE IF EXISTS public.today_houses CASCADE;
CREATE TABLE public.today_houses (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  full_name TEXT NOT NULL,
  phone TEXT NOT NULL,
  address TEXT NOT NULL,
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  note TEXT,                                    -- เพิ่ม note
  order_index INT DEFAULT 0,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
ALTER TABLE public.today_houses ENABLE ROW LEVEL SECURITY;
CREATE POLICY "today_houses_select" ON public.today_houses FOR SELECT USING (auth.uid() = user_id);
CREATE POLICY "today_houses_insert" ON public.today_houses FOR INSERT WITH CHECK (auth.uid() = user_id);
CREATE POLICY "today_houses_update" ON public.today_houses FOR UPDATE USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
CREATE POLICY "today_houses_delete" ON public.today_houses FOR DELETE USING (auth.uid() = user_id);
CREATE INDEX idx_today_houses_user_id ON public.today_houses(user_id);
CREATE INDEX idx_today_houses_order ON public.today_houses(order_index);

-- 4. pending_houses (งานค้าง) ← เพิ่ม note ด้วย (เผื่ออนาคต)
DROP TABLE IF EXISTS public.pending_houses CASCADE;
CREATE TABLE public.pending_houses (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  full_name TEXT NOT NULL,
  phone TEXT NOT NULL,
  address TEXT NOT NULL,
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  note TEXT,                                    -- เพิ่ม note
  order_index INT DEFAULT 0,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  original_date DATE NOT NULL
);
ALTER TABLE public.pending_houses ENABLE ROW LEVEL SECURITY;
CREATE POLICY "pending_select" ON public.pending_houses FOR SELECT USING (auth.uid() = user_id);
CREATE POLICY "pending_insert" ON public.pending_houses FOR INSERT WITH CHECK (auth.uid() = user_id);
CREATE POLICY "pending_update" ON public.pending_houses FOR UPDATE USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
CREATE POLICY "pending_delete" ON public.pending_houses FOR DELETE USING (auth.uid() = user_id);
CREATE INDEX idx_pending_user_id ON public.pending_houses(user_id);
CREATE INDEX idx_pending_original_date ON public.pending_houses(original_date);

-- ใหม่: start_positions (จุดเริ่มต้นนำทาง - ถาวรต่อ user)
DROP TABLE IF EXISTS public.start_positions CASCADE;
CREATE TABLE public.start_positions (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  lat DOUBLE PRECISION NOT NULL,
  lng DOUBLE PRECISION NOT NULL,
  name TEXT, -- ชื่อจุดเริ่มต้น (optional, e.g., "บ้าน")
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
ALTER TABLE public.start_positions ENABLE ROW LEVEL SECURITY;
CREATE POLICY "start_positions_select" ON public.start_positions FOR SELECT USING (auth.uid() = user_id);
CREATE POLICY "start_positions_insert" ON public.start_positions FOR INSERT WITH CHECK (auth.uid() = user_id);
CREATE POLICY "start_positions_update" ON public.start_positions FOR UPDATE USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
CREATE POLICY "start_positions_delete" ON public.start_positions FOR DELETE USING (auth.uid() = user_id);
CREATE INDEX idx_start_positions_user_id ON public.start_positions(user_id);
-- UNIQUE constraint เพื่อให้ user มีจุดเริ่มต้นเดียว (latest one)
CREATE UNIQUE INDEX unique_start_position_per_user ON public.start_positions(user_id);

-- 6. Trigger updated_at
CREATE OR REPLACE FUNCTION trigger_set_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER set_timestamp_today_houses BEFORE UPDATE ON public.today_houses FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
CREATE TRIGGER set_timestamp_pending_houses BEFORE UPDATE ON public.pending_houses FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
CREATE TRIGGER set_timestamp_start_positions BEFORE UPDATE ON public.start_positions FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();

-- 8. RPC: ดึงงานค้าง → ใช้งานได้ 100%
CREATE OR REPLACE FUNCTION load_pending_to_today(p_original_date date)
RETURNS void AS $$
BEGIN
  -- ลบของซ้ำก่อน (ป้องกัน)
  DELETE FROM public.today_houses
  WHERE user_id = auth.uid()
    AND (full_name, phone) IN (
      SELECT full_name, phone
      FROM public.pending_houses
      WHERE user_id = auth.uid() AND original_date = p_original_date
    );
  -- ดึงมา + เรียงลำดับใหม่ตั้งแต่ 1
  INSERT INTO public.today_houses (
    user_id, full_name, phone, address, lat, lng, order_index,
    created_at, updated_at
  )
  SELECT
    user_id, full_name, phone, address, lat, lng,
    row_number() OVER (ORDER BY id) AS order_index,
    created_at, NOW()
  FROM public.pending_houses
  WHERE user_id = auth.uid() AND original_date = p_original_date;
  -- ลบออกจาก pending
  DELETE FROM public.pending_houses
  WHERE user_id = auth.uid() AND original_date = p_original_date;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 9. RPC: refresh_and_merge_today_houses (merge lat/lng จาก houses ถ้าไม่มีใน today)
DROP FUNCTION IF EXISTS refresh_and_merge_today_houses();
CREATE OR REPLACE FUNCTION refresh_and_merge_today_houses()
RETURNS TABLE (
  id UUID,
  user_id UUID,
  full_name TEXT,
  phone TEXT,
  address TEXT,
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  order_index INTEGER,
  created_at TIMESTAMPTZ,
  updated_at TIMESTAMPTZ
) AS $$
BEGIN
  RETURN QUERY
  SELECT
    t.id,
    t.user_id,
    t.full_name,
    t.phone,
    t.address,
    COALESCE(t.lat, h.lat) AS lat,
    COALESCE(t.lng, h.lng) AS lng,
    t.order_index,
    t.created_at,
    t.updated_at
  FROM public.today_houses t
  LEFT JOIN public.houses h ON (TRIM(t.full_name) = TRIM(h.full_name) AND t.phone = h.phone)
  WHERE t.user_id = auth.uid()
  ORDER BY t.order_index ASC;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- ใหม่: RPC สำหรับจัดการ start_position (load latest, save/update, clear)
-- Load latest start position
CREATE OR REPLACE FUNCTION get_start_position()
RETURNS TABLE (
  lat DOUBLE PRECISION,
  lng DOUBLE PRECISION,
  name TEXT
) AS $$
BEGIN
  RETURN QUERY
  SELECT lat, lng, name
  FROM public.start_positions
  WHERE user_id = auth.uid()
  ORDER BY created_at DESC
  LIMIT 1;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Save or update start position (delete old if exist)
CREATE OR REPLACE FUNCTION save_start_position(p_lat DOUBLE PRECISION, p_lng DOUBLE PRECISION, p_name TEXT DEFAULT NULL)
RETURNS void AS $$
BEGIN
  -- ลบเก่าก่อน (unique per user)
  DELETE FROM public.start_positions WHERE user_id = auth.uid();
  -- Insert ใหม่
  INSERT INTO public.start_positions (user_id, lat, lng, name)
  VALUES (auth.uid(), p_lat, p_lng, p_name);
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Clear start position
CREATE OR REPLACE FUNCTION clear_start_position()
RETURNS void AS $$
BEGIN
  DELETE FROM public.start_positions WHERE user_id = auth.uid();
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- สำคัญมาก! อนุญาตให้เรียกใช้ RPC ได้
GRANT EXECUTE ON FUNCTION load_pending_to_today(date) TO authenticated;
GRANT EXECUTE ON FUNCTION refresh_and_merge_today_houses() TO authenticated;
GRANT EXECUTE ON FUNCTION get_start_position() TO authenticated;
GRANT EXECUTE ON FUNCTION save_start_position(DOUBLE PRECISION, DOUBLE PRECISION, TEXT) TO authenticated;
GRANT EXECUTE ON FUNCTION clear_start_position() TO authenticated;
